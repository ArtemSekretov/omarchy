#!/bin/bash

# Go from current active terminal to its child shell process and run cwd there
terminal_pid=$(hyprctl activewindow | awk '/pid:/ {print $2}')

# Start from the newest child and go backwards → early exit as soon as we find one valid cwd
for pid in $(pgrep -P "$terminal_pid" | sort -nr); do
    cwd=$(readlink -f "/proc/${pid}/cwd" 2>/dev/null)
    if [[ -n "$cwd" && "$cwd" != /proc/* && -d "$cwd" ]]; then
        echo "$cwd"
        exit 0
    fi
done

# If we reach here → no valid cwd found
echo "$HOME"
